#!/bin/sh
# Runs an adversarial Codex review over exactly what is about to be pushed, and
# refuses the push unless it comes back approved.
#
# The reviewer compares a base against the checked-out HEAD. That shape can
# only speak for a fast-forward of the current branch, so every other kind of
# push is refused rather than waved through on a review that did not cover it.
#
# This cannot live in GitHub Actions: it drives the local Codex CLI under your
# own credentials. It therefore only guards pushes from a machine where it is
# installed — see tools/install-hooks.sh.
#
# Bypass a single push with `git push --no-verify`.
set -eu

DESTINATION="${2:-${1:-origin}}"
EMPTY_SHA="0000000000000000000000000000000000000000"

refuse() {
    echo "pre-push: $1" >&2
    echo "pre-push: push refused. Override deliberately with --no-verify." >&2
    exit 1
}

# The plugin installs under a versioned directory, so pinning a version here
# would turn the next plugin update into a gate that refuses every push. Take
# an explicit setting when there is one, otherwise the newest installed.
find_companion() {
    if [ -n "${CODEX_COMPANION:-}" ]; then
        printf '%s' "$CODEX_COMPANION"
        return
    fi
    configured=$(git config --get codex.companion || true)
    if [ -n "$configured" ]; then
        printf '%s' "$configured"
        return
    fi
    ls -d "$HOME"/.claude/plugins/cache/openai-codex/codex/*/scripts/codex-companion.mjs 2>/dev/null |
        sort -V | tail -1
}

COMPANION=$(find_companion)
[ -n "$COMPANION" ] && [ -f "$COMPANION" ] || refuse "no Codex companion found.
pre-push:   Install the codex plugin, or point at it with:
pre-push:     git config codex.companion <path to codex-companion.mjs>"

# git feeds one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
    # Deleting a branch pushes no content to review.
    [ "$local_sha" = "$EMPTY_SHA" ] && continue

    if [ "$local_sha" != "$(git rev-parse HEAD)" ]; then
        refuse "$local_sha is not the checked-out HEAD, so the review cannot cover it"
    fi

    if [ "$remote_sha" = "$EMPTY_SHA" ]; then
        # A ref the destination does not have yet. The baseline has to come
        # from what that destination actually advertises now — a local
        # remote-tracking ref can name a commit another destination never had,
        # or one a rewind has since removed. The root commit is not a baseline
        # either: using it would exclude everything it introduced.
        base=""
        for candidate in $(git ls-remote --heads "$DESTINATION" 2>/dev/null | cut -f1); do
            git cat-file -e "$candidate^{commit}" 2>/dev/null || continue
            git merge-base --is-ancestor "$candidate" "$local_sha" 2>/dev/null || continue
            if [ -z "$base" ] || git merge-base --is-ancestor "$base" "$candidate" 2>/dev/null; then
                base="$candidate"
            fi
        done
        [ -n "$base" ] || refuse "$DESTINATION advertises no reviewed baseline for this ref"
    else
        # A force push can remove commits from the remote, and a base..HEAD
        # comparison cannot show what is being discarded.
        git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null ||
            refuse "this is not a fast-forward, so the review cannot show what it removes"
        base="$remote_sha"
    fi

    if [ "$base" = "$local_sha" ]; then
        echo "pre-push: nothing new to review."
        continue
    fi

    count=$(git rev-list --count "$base..$local_sha")
    echo "pre-push: reviewing $count commit(s) against $(git rev-parse --short "$base")..."

    # --json so the verdict is read from the structured result. Progress goes
    # to the terminal on stderr; only the payload is captured.
    payload=$(node "$COMPANION" adversarial-review --wait --json --base "$base") ||
        refuse "the review did not complete"

    # Compared against the sha being pushed, not against a HEAD read later:
    # anything between the first check and here could have moved it, and the
    # verdict has to bind to the commit git is about to send. Detecting a move
    # is not preventing one — an interleaving that moves HEAD away and back
    # would go unseen — but it stops an approval of one tree from authorising
    # another.
    [ "$(git rev-parse HEAD)" = "$local_sha" ] ||
        refuse "HEAD moved while the review ran, so its verdict does not cover $local_sha"

    # The verdict decides: a review that ran but found problems still exits zero.
    printf '%s' "$payload" | node "$(dirname "$0")/review-verdict.mjs" ||
        refuse "the review did not approve these changes"
done

echo "pre-push: approved."
