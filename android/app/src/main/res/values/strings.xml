    <!-- Home -->
    <string name="identities_header">Your identities</string>
    <string name="home_identities_explain">Each identity is a separate key for one RP. You can answer the same RP as several identities, but no identity is ever used with another RP.</string>
    <string name="home_identities_footer">sub is the JWK thumbprint (RFC 7638) of the public key. Even RPs working together cannot tell they share a user.</string>
    <string name="home_empty">No identities yet. When an RP sends an authentication request, you can create an identity for it.</string>
    <string name="home_metadata_header">Discovery metadata</string>
    <string name="home_metadata_footer">When an authentication request starting with openid:// arrives, the app asks which identity should answer.</string>

